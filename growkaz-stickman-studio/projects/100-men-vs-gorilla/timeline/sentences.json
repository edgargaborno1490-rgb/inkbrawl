[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.02,
  "text": "One hundred men."
 },
 {
  "i": 1,
  "start": 1.41,
  "end": 2.33,
  "text": "One gorilla."
 },
 {
  "i": 2,
  "start": 2.63,
  "end": 3.33,
  "text": "Who would win?"
 },
 {
  "i": 3,
  "start": 3.71,
  "end": 6.93,
  "text": "This is Ink Brawl, and this is our very first video."
 },
 {
  "i": 4,
  "start": 7.45,
  "end": 8.3,
  "text": "Meet the gorilla."
 },
 {
  "i": 5,
  "start": 8.52,
  "end": 14.14,
  "text": "Four hundred pounds of muscle, several times stronger than any man here, with two-inch fangs."
 },
 {
  "i": 6,
  "start": 14.42,
  "end": 15.59,
  "text": "Wave one charges."
 },
 {
  "i": 7,
  "start": 15.78,
  "end": 17.83,
  "text": "One swing, and they go flying."
 },
 {
  "i": 8,
  "start": 18.06,
  "end": 19.58,
  "text": "Wave two grabs his arms."
 },
 {
  "i": 9,
  "start": 19.78,
  "end": 20.98,
  "text": "He slams the ground."
 },
 {
  "i": 10,
  "start": 21.29,
  "end": 21.79,
  "text": "Gone."
 },
 {
  "i": 11,
  "start": 21.99,
  "end": 24.05,
  "text": "Then fifty men pile on top of him."
 },
 {
  "i": 12,
  "start": 24.3,
  "end": 25.35,
  "text": "It looks like it's over."
 },
 {
  "i": 13,
  "start": 25.65,
  "end": 27.1,
  "text": "Then he stands up."
 },
 {
  "i": 14,
  "start": 27.1,
  "end": 28.9,
  "text": "The pile explodes."
 },
 {
  "i": 15,
  "start": 29.18,
  "end": 30.2,
  "text": "And the men who are left?"
 },
 {
  "i": 16,
  "start": 30.44,
  "end": 31.15,
  "text": "They run."
 },
 {
  "i": 17,
  "start": 31.45,
  "end": 33.51,
  "text": "Our verdict: the gorilla wins."
 },
 {
  "i": 18,
  "start": 33.8,
  "end": 38.31,
  "text": "A hundred men only win if nobody runs, and nobody wants to be next."
 },
 {
  "i": 19,
  "start": 38.68,
  "end": 39.99,
  "text": "Here's how Ink Brawl works."
 },
 {
  "i": 20,
  "start": 40.19,
  "end": 42.69,
  "text": "Follow, and you become a stick man with your name on it."
 },
 {
  "i": 21,
  "start": 42.92,
  "end": 45.98,
  "text": "Every time you comment, your fighter levels up and gets stronger."
 },
 {
  "i": 22,
  "start": 46.18,
  "end": 48.41,
  "text": "And every follower goal unlocks a boss."
 },
 {
  "i": 23,
  "start": 48.61,
  "end": 50.69,
  "text": "Ten followers: an angry goose."
 },
 {
  "i": 24,
  "start": 50.9,
  "end": 52.53,
  "text": "Fifty: a grizzly bear."
 },
 {
  "i": 25,
  "start": 52.69,
  "end": 56.16,
  "text": "And at one hundred, all of you get a rematch with this gorilla."
 },
 {
  "i": 26,
  "start": 56.39,
  "end": 58.01,
  "text": "Comment the fighter you want to be."
 },
 {
  "i": 27,
  "start": 58.22,
  "end": 58.71,
  "text": "Ninja?"
 },
 {
  "i": 28,
  "start": 58.91,
  "end": 59.58,
  "text": "Samurai?"
 },
 {
  "i": 29,
  "start": 59.71,
  "end": 60.42,
  "text": "Caveman?"
 },
 {
  "i": 30,
  "start": 60.61,
  "end": 61.16,
  "text": "Anything."
 },
 {
  "i": 31,
  "start": 61.39,
  "end": 63.33,
  "text": "The most requested gets drawn first."
 }
]