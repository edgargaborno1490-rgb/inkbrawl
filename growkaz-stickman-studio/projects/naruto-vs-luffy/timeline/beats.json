[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 1.69,
  "text": "Naruto versus Luffy.",
  "end": 1.98
 },
 {
  "i": 1,
  "start": 1.98,
  "speechStart": 2.13,
  "speechEnd": 5.1,
  "text": "Gear Five against Six Paths. Who would win?",
  "end": 5.6
 },
 {
  "i": 2,
  "start": 5.6,
  "speechStart": 5.75,
  "speechEnd": 7.01,
  "text": "Luffy strikes first:",
  "end": 7.18
 },
 {
  "i": 3,
  "start": 7.18,
  "speechStart": 7.33,
  "speechEnd": 10.79,
  "text": "Gear Second, Jet Pistol, faster than the eye can follow.",
  "end": 11.15
 },
 {
  "i": 4,
  "start": 11.15,
  "speechStart": 11.3,
  "speechEnd": 12.83,
  "text": "Naruto answers his way:",
  "end": 12.98
 },
 {
  "i": 5,
  "start": 12.98,
  "speechStart": 13.13,
  "speechEnd": 14.89,
  "text": "an army of shadow clones.",
  "end": 15.08
 },
 {
  "i": 6,
  "start": 15.08,
  "speechStart": 15.23,
  "speechEnd": 18.26,
  "text": "Luffy's future sight reads every clone before it moves.",
  "end": 18.51
 },
 {
  "i": 7,
  "start": 18.51,
  "speechStart": 18.66,
  "speechEnd": 20.35,
  "text": "Gear Fourth, Snakeman.",
  "end": 20.52
 },
 {
  "i": 8,
  "start": 20.52,
  "speechStart": 20.67,
  "speechEnd": 24.3,
  "text": "His punches bend around corners, and clones burst into smoke.",
  "end": 24.47
 },
 {
  "i": 9,
  "start": 24.47,
  "speechStart": 24.62,
  "speechEnd": 27.64,
  "text": "But every clone that pops sends Naruto what it saw.",
  "end": 27.91
 },
 {
  "i": 10,
  "start": 27.91,
  "speechStart": 28.06,
  "speechEnd": 32.76,
  "text": "Naruto goes Sage Mode, then Kurama's golden cloak, and throws a Rasenshuriken.",
  "end": 33.04
 },
 {
  "i": 11,
  "start": 33.04,
  "speechStart": 33.19,
  "speechEnd": 36.67,
  "text": "Luffy coats his fists in Conqueror's Haki and takes it head on.",
  "end": 36.97
 },
 {
  "i": 12,
  "start": 36.97,
  "speechStart": 37.12,
  "speechEnd": 39.55,
  "text": "Then the drums start. Gear Five.",
  "end": 39.89
 },
 {
  "i": 13,
  "start": 39.89,
  "speechStart": 40.04,
  "speechEnd": 43.29,
  "text": "Luffy turns the ground to rubber and bounces the whole arena.",
  "end": 43.51
 },
 {
  "i": 14,
  "start": 43.51,
  "speechStart": 43.66,
  "speechEnd": 45.93,
  "text": "For a moment, Naruto has no answer.",
  "end": 46.11
 },
 {
  "i": 15,
  "start": 46.11,
  "speechStart": 46.26,
  "speechEnd": 49.0,
  "text": "But Gear Five burns Luffy's stamina fast.",
  "end": 49.12
 },
 {
  "i": 16,
  "start": 49.12,
  "speechStart": 49.27,
  "speechEnd": 52.0,
  "text": "Against Kizaru, it left him shriveled and drained.",
  "end": 52.31
 },
 {
  "i": 17,
  "start": 52.31,
  "speechStart": 52.46,
  "speechEnd": 58.13,
  "text": "Naruto carries the chakra of all nine tailed beasts. Six Paths. Truth-Seeking Balls.",
  "end": 58.29
 },
 {
  "i": 18,
  "start": 58.29,
  "speechStart": 58.44,
  "speechEnd": 60.13,
  "text": "He only has to outlast him.",
  "end": 60.48
 },
 {
  "i": 19,
  "start": 60.48,
  "speechStart": 60.63,
  "speechEnd": 62.65,
  "text": "Naruto wins, but it's close.",
  "end": 62.82
 },
 {
  "i": 20,
  "start": 62.82,
  "speechStart": 62.97,
  "speechEnd": 64.53,
  "text": "Luffy hits harder in the moment.",
  "end": 64.72
 },
 {
  "i": 21,
  "start": 64.72,
  "speechStart": 64.87,
  "speechEnd": 67.87,
  "text": "Naruto has the bigger tank, and clones to wear him down.",
  "end": 68.11
 },
 {
  "i": 22,
  "start": 68.11,
  "speechStart": 68.26,
  "speechEnd": 69.85,
  "text": "Comment who YOU think wins.",
  "end": 69.9
 },
 {
  "i": 23,
  "start": 69.9,
  "speechStart": 70.05,
  "speechEnd": 71.49,
  "text": "And who should fight next?",
  "end": 72.99
 }
]